# Protect the webhook endpoint. Configure the same header in your alert provider.
WEBHOOK_TOKEN=replace-with-a-long-random-secret
ALERT_COOLDOWN_SECONDS=900
DB_PATH=/data/alerts.db

# Email: use an approved SMTP relay or mail service credentials from a secret manager.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=sre-agent@example.com
ALERT_EMAIL_TO=sre-oncall@example.com,platform-team@example.com

# Optional AI triage. Without OPENAI_API_KEY, safe rule-based triage is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional read-only Kubernetes evidence collection; keep false unless explicitly configured.
ENABLE_KUBECTL_READONLY=false
